<Window x:Class="recTivo.Frontend.Dialogos.Clientes.DialogoConsultaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel>

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="LISTADO DE CLIENTES"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Grid.Column="1"/>
                </Grid>

                <Grid Margin="20">
                    <DataGrid ItemsSource="{Binding ListaClientes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HorizontalAlignment="Center"
                              RowHeaderWidth="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" 
                                                Width="*"                                                
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Apellido 1" Binding="{Binding Apellido1}" 
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Apellido 2" Binding="{Binding Apellido2}" 
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" 
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" 
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" 
                                                Width="120"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Contraseña" Binding="{Binding Password}" 
                                                Width="120"
                                                IsReadOnly="True"/>
                            
                            
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>