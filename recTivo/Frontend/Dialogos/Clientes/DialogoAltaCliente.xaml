<Window x:Class="recTivo.Frontend.Dialogos.Clientes.DialogoAltaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="430" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None"
        Validation.Error="OnErrorEvent">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder x:Name="placeholder"/>
                            <TextBlock Text="{Binding [0].ErrorContent}"
                                       Foreground="Red"
                                       FontSize="10"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                    Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA CLIENTE"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="30,20,30,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="10,0,10,0">

                            <TextBlock Text="Nombre:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Nombre,
                                             ValidatesOnDataErrors=True,
                                             NotifyOnValidationError=True,
                                             UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                            <TextBlock Text="Primer apellido:" Foreground="#FF9800" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding Apellido1,
                                             ValidatesOnDataErrors=True,
                                             NotifyOnValidationError=True,
                                             UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                            <TextBlock Text="Segundo apellido:" Foreground="#FF9800" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding Apellido2, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                            <TextBlock Text="DNI:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Dni,
                                             ValidatesOnDataErrors=True,
                                             NotifyOnValidationError=True,
                                             UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0">

                            <TextBlock Text="Teléfono:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                            <TextBlock Text="Usuario:" Foreground="#FF9800" />
                            <TextBox Text="{Binding Usuario,
                                             ValidatesOnDataErrors=True,
                                             NotifyOnValidationError=True,
                                             UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Margin="0,2,0,8" Width="180" HorizontalAlignment="Left"/>

                            <TextBlock Text="Contraseña:" Foreground="#FF9800" Margin="0,10,0,0"/>
                            <PasswordBox x:Name="txtPassword"
                                         Height="30" Margin="0,2,0,8" Width="180"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         HorizontalAlignment="Left"/>

                            <Button Content="Guardar cliente"
                                    Click="btnGuardarCliente_Click"
                                    IsEnabled="{Binding HasNoErrors}"
                                    Height="30" Width="180"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    BorderBrush="#FF5722"
                                    Background="#E0E0E0"
                                    Foreground="#FF5722"
                                    FontWeight="Bold"/>

                        </StackPanel>
                    </Grid>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>

</Window>
