<Window x:Class="recTivo.Frontend.Dialogos.Clientes.DialogoAltaClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:recTivo.Frontend.Dialogos.Clientes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None"
        Title="Pulsa ESC para volver atrás" Height="500" Width="600">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>


        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Background="#1E1E1E">
        <TextBlock Text="Alta de Clientes"
               Foreground="White"
               FontSize="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,20,0,0"/>
    </Grid>
</Window>
