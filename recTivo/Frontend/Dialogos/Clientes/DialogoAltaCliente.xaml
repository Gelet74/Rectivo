<Window x:Class="recTivo.Frontend.Dialogos.Clientes.DialogoAltaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="420" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel>

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA CLIENTE"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Grid.Column="1"/>
                </Grid>

                <Grid Margin="5,20,0,0">
                    <StackPanel>

                        <TextBlock Text="Nombre:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" 
                                 Height="30" 
                                 HorizontalAlignment="Left"
                                 Margin="0,5"/>

                        <TextBlock Text="Primer apellido:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Apellido1, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" 
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,5"/>

                        <TextBlock Text="Segundo apellido:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Apellido2, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" 
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,5"/>

                        <TextBlock Text="DNI:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" 
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,5"/>

                        <TextBlock Text="Teléfono:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" 
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,5"/>

                        <Button Content="Guardar cliente"
                                x:Name="btnGuardarCliente"
                                Click="btnGuardarCliente_Click"
                                Width="160"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,20,0,0"
                                Background="#E0E0E0"
                                Foreground="#FF9800"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
