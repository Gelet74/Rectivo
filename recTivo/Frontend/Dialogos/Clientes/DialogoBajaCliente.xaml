<Window x:Class="recTivo.Frontend.Dialogos.Clientes.DialogoBajaCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="300" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel>

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="BAJA CLIENTE"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Grid.Column="1"/>
                </Grid>

                <Grid Margin="30">
                    <StackPanel>

                        <TextBlock Text="Selecciona cliente:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaClientes}"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  Width="300" Height="30" Margin="0,5"/>

                        <Button Content="Dar de baja"
                                x:Name="btnBajaCliente"
                                Click="btnBajaCliente_Click"
                                Width="160"
                                Height="30"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Background="#E0E0E0"
                                Foreground="#FF9800"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
