<Window x:Class="recTivo.Frontend.Dialogos.Ordenes.DialogoProcesarOrden"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Height="720" Width="980"
        Language="es-ES">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"                Value="#E0E0E0"/>
            <Setter Property="RowBackground"             Value="#F5F5F5"/>
            <Setter Property="AlternatingRowBackground"  Value="#E8E8E8"/>
            <Setter Property="GridLinesVisibility"       Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"  Value="#CCCCCC"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="CanUserAddRows"            Value="False"/>
            <Setter Property="AutoGenerateColumns"       Value="False"/>
            <Setter Property="RowHeaderWidth"            Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="GENERAR ÓRDENES DE FABRICACIÓN"
                               Foreground="White" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="20">

                    <TabControl x:Name="tabControl"
                                Background="#2D2D30"
                                BorderBrush="#FF9800" BorderThickness="0,2,0,0"
                                SelectionChanged="TabControl_SelectionChanged">

                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background"      Value="#3A3A3D"/>
                                <Setter Property="Foreground"      Value="#FF9800"/>
                                <Setter Property="FontWeight"      Value="Bold"/>
                                <Setter Property="FontSize"        Value="13"/>
                                <Setter Property="Padding"         Value="18,8"/>
                                <Setter Property="BorderThickness" Value="0"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4A4A4D"/>
                                        <Setter Property="FontSize"   Value="15"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Background" Value="#3A3A3D"/>
                                        <Setter Property="FontSize"   Value="13"/>
                                    </Trigger>
                                </Style.Triggers>

                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="Desde PT">

                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Artículos PT disponibles:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,8"/>

                                            <ListBox x:Name="lstPT"
                                                     ItemsSource="{Binding ArticulosPT}"
                                                     Background="Transparent" BorderThickness="0"
                                                     MaxHeight="340"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="White" Margin="0,3"
                                                                  Checked="ChkPT_Checked"
                                                                  Unchecked="ChkPT_Unchecked">

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Codigo}" FontWeight="Bold" Foreground="White"/>
                                                                <TextBlock Text="{Binding descrip}"  Foreground="#AAAAAA" FontSize="11"/>
                                                                <TextBlock Text="{Binding descrip2}" Foreground="#AAAAAA" FontSize="11"/>
                                                            </StackPanel>

                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding"    Value="2"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>

                                            <TextBlock Text="PT seleccionados — introduce la cantidad a fabricar:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,8"/>

                                            <DataGrid x:Name="dgPTSeleccionados"
                                                      ItemsSource="{Binding PTSeleccionados}"
                                                      IsReadOnly="False"
                                                      MaxHeight="340">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código"
                                                                        Binding="{Binding Codigo}"
                                                                        Width="120"
                                                                        IsReadOnly="True"
                                                                        FontWeight="SemiBold"/>

                                                    <DataGridTextColumn Header="Descripción"
                                                                        Binding="{Binding Descripcion}"
                                                                        Width="*"
                                                                        IsReadOnly="True"/>

                                                    <DataGridTextColumn Header="Descripción 2"
                                                                        Binding="{Binding Descripcion2}"
                                                                        Width="*"
                                                                        IsReadOnly="True"/>

                                                    <DataGridTextColumn Header="Cantidad"
                                                                        Binding="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"
                                                                        Width="90"/>
                                                </DataGrid.Columns>

                                            </DataGrid>

                                            <TextBlock Text="Haz doble clic en la celda Cantidad para editarla."
                                                       Foreground="#888" FontSize="11" Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <Border Grid.Row="1" Background="#3A3A3D" CornerRadius="4"
                                        Padding="16,10" Margin="0,12,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical"
                                                    Margin="0,0,30,0" VerticalAlignment="Center">

                                            <TextBlock Text="Fecha fin para todas las órdenes*:"
                                                       Foreground="#FF9800" Margin="0,0,0,4"/>

                                            <Grid Width="160" Height="30">
                                                <DatePicker x:Name="dpFechaFin"
                                                            SelectedDate="{Binding FechaFin, Mode=TwoWay}"
                                                            Background="#2D2D30"
                                                            BorderBrush="#FF9800">
                                                    <DatePicker.Resources>
                                                        <Style TargetType="DatePickerTextBox">
                                                            <Setter Property="Foreground" Value="Transparent"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </Style>
                                                    </DatePicker.Resources>
                                                </DatePicker>
                                                <TextBlock Text="{Binding SelectedDate, ElementName=dpFechaFin, StringFormat={}{0:dd/MM/yyyy}}"
                                                           Foreground="#FF9800"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,30,0"
                                                           IsHitTestVisible="False"
                                                           Panel.ZIndex="9999"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">

                                            <TextBlock Text="¿Generar también orden del PT?"
                                                       Foreground="#FF9800" Margin="0,0,0,6"/>

                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="rbSoloPT"
                                                             Content="Solo componentes PS"
                                                             GroupName="opcionPT"
                                                             Checked="RbSoloPT_Checked"
                                                             Foreground="White"
                                                             Margin="0,0,20,0"/>

                                                <RadioButton x:Name="rbConPT"
                                                             Content="PS + orden del PT"
                                                             GroupName="opcionPT"
                                                             Checked="RbConPT_Checked"
                                                             Foreground="White"/>
                                            </StackPanel>

                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Calcular órdenes"
                                                Click="BtnCalcular_Click"
                                                Width="180" Height="36"
                                                Background="#FF9800" Foreground="White"
                                                BorderBrush="#FF9800" FontWeight="Bold"
                                                VerticalAlignment="Center" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2"
                                        Visibility="{Binding PreviewVisible, Converter={StaticResource BoolToVis}}"
                                        Background="#1E1E1E" BorderBrush="#FF9800" BorderThickness="1"
                                        CornerRadius="4" Margin="0,12,0,0" Padding="0">
                                    <StackPanel>

                                        <TextBlock Text="Órdenes que se generarán:"
                                                   Foreground="#FF9800" FontWeight="Bold"
                                                   Margin="12,10,0,8"/>
                                        <DataGrid ItemsSource="{Binding OrdenesPreview}"
                                                  IsReadOnly="True"
                                                  MaxHeight="200"
                                                  Margin="8,0,8,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tipo"
                                                                    Binding="{Binding Tipo}"
                                                                    Width="55"/>

                                                <DataGridTextColumn Header="Código"
                                                                    Binding="{Binding CodigoArticulo}"
                                                                    Width="120"
                                                                    FontWeight="SemiBold"/>

                                                <DataGridTextColumn Header="Descripción"
                                                                    Binding="{Binding Descripcion}"
                                                                    Width="*"/>

                                                <DataGridTextColumn Header="Descripción 2"
                                                                    Binding="{Binding Descripcion2}"
                                                                    Width="*"/>

                                                <DataGridTextColumn Header="Cantidad"
                                                                    Binding="{Binding Cantidad, StringFormat={}{0:0.##}}"
                                                                    Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="3"
                                      Visibility="{Binding PreviewVisible, Converter={StaticResource BoolToVis}}"
                                      Margin="0,8,0,0">

                                    <Button Content="Confirmar y generar órdenes"
                                            Click="BtnConfirmar_Click"
                                            HorizontalAlignment="Right"
                                            Width="240" Height="36"
                                            Background="#FF9800" Foreground="White"
                                            BorderBrush="#FF9800" FontWeight="Bold"
                                            Cursor="Hand"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="PS directo">

                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Artículos PS disponibles:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,6"/>

                                            <ListBox x:Name="lstPS"
                                                     ItemsSource="{Binding ArticulosPSFiltrados}"
                                                     Background="Transparent" BorderThickness="0"
                                                     MaxHeight="310"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Foreground="White" Margin="0,3"
                                                                  Checked="ChkPS_Checked"
                                                                  Unchecked="ChkPS_Unchecked">

                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Codigo}" FontWeight="Bold" Foreground="White"/>
                                                                <TextBlock Text="{Binding descrip}"  Foreground="#AAAAAA" FontSize="11"/>
                                                                <TextBlock Text="{Binding descrip2}" Foreground="#AAAAAA" FontSize="11"/>
                                                            </StackPanel>

                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>

                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding"    Value="2"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>

                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- PS seleccionados -->
                                    <Border Grid.Column="2" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>

                                            <TextBlock Text="PS seleccionados — introduce la cantidad a fabricar:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,8"/>

                                            <DataGrid x:Name="dgPSSeleccionados"
                                                      ItemsSource="{Binding PSSeleccionados}"
                                                      IsReadOnly="False"
                                                      MaxHeight="340">

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código"
                                                                        Binding="{Binding Codigo}"
                                                                        Width="120"
                                                                        IsReadOnly="True"
                                                                        FontWeight="SemiBold"/>

                                                    <DataGridTextColumn Header="Descripción"
                                                                        Binding="{Binding Descripcion}"
                                                                        Width="*"
                                                                        IsReadOnly="True"/>

                                                    <DataGridTextColumn Header="Descripción 2"
                                                                        Binding="{Binding Descripcion2}"
                                                                        Width="*"
                                                                        IsReadOnly="True"/>

                                                    <DataGridTextColumn Header="Cantidad"
                                                                        Binding="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"
                                                                        Width="90"/>
                                                </DataGrid.Columns>

                                            </DataGrid>

                                            <TextBlock Text="Haz doble clic en la celda Cantidad para editarla."
                                                       Foreground="#888" FontSize="11" Margin="0,6,0,0"/>

                                        </StackPanel>
                                    </Border>

                                </Grid>

                                <!-- FECHA FIN PS -->
                                <Border Grid.Row="1" Background="#3A3A3D" CornerRadius="4"
                                        Padding="16,10" Margin="0,12,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical"
                                                    Margin="0,0,30,0" VerticalAlignment="Center">

                                            <TextBlock Text="Fecha fin para todas las órdenes*:"
                                                       Foreground="#FF9800" Margin="0,0,0,4"/>

                                            <Grid Width="160" Height="30">
                                                <DatePicker x:Name="dpFechaFinPS"
                                                            SelectedDate="{Binding FechaFinPS, Mode=TwoWay}"
                                                            Background="#2D2D30"
                                                            BorderBrush="#FF9800">
                                                    <DatePicker.Resources>
                                                        <Style TargetType="DatePickerTextBox">
                                                            <Setter Property="Foreground" Value="Transparent"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </Style>
                                                    </DatePicker.Resources>
                                                </DatePicker>
                                                <TextBlock Text="{Binding SelectedDate, ElementName=dpFechaFinPS, StringFormat={}{0:dd/MM/yyyy}}"
                                                           Foreground="Black"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,30,0"
                                                           IsHitTestVisible="False"
                                                           Panel.ZIndex="9999"/>
                                            </Grid>

                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Calcular órdenes PS"
                                                Click="BtnCalcularPS_Click"
                                                Width="200" Height="36"
                                                Background="#FF9800" Foreground="White"
                                                BorderBrush="#FF9800" FontWeight="Bold"
                                                VerticalAlignment="Center" Cursor="Hand"/>

                                    </Grid>

                                </Border>

                                <Border Grid.Row="2"
                                        Visibility="{Binding PreviewPSVisible, Converter={StaticResource BoolToVis}}"
                                        Background="#1E1E1E" BorderBrush="#FF9800" BorderThickness="1"
                                        CornerRadius="4" Margin="0,12,0,0" Padding="0">

                                    <StackPanel>

                                        <TextBlock Text="Órdenes PS que se generarán:"
                                                   Foreground="#FF9800" FontWeight="Bold"
                                                   Margin="12,10,0,8"/>

                                        <DataGrid ItemsSource="{Binding OrdenesPSPreview}"
                                                  IsReadOnly="True"
                                                  MaxHeight="200"
                                                  Margin="8,0,8,8">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Código"
                                                                    Binding="{Binding CodigoArticulo}"
                                                                    Width="120"
                                                                    FontWeight="SemiBold"/>

                                                <DataGridTextColumn Header="Descripción"
                                                                    Binding="{Binding Descripcion}"
                                                                    Width="*"/>

                                                <DataGridTextColumn Header="Descripción 2"
                                                                    Binding="{Binding Descripcion2}"
                                                                    Width="*"/>

                                                <DataGridTextColumn Header="Cantidad"
                                                                    Binding="{Binding Cantidad, StringFormat={}{0:0.##}}"
                                                                    Width="90"/>
                                            </DataGrid.Columns>

                                        </DataGrid>

                                    </StackPanel>

                                </Border>

                                <Grid Grid.Row="3"
                                      Visibility="{Binding PreviewPSVisible, Converter={StaticResource BoolToVis}}"
                                      Margin="0,8,0,0">

                                    <Button Content="Confirmar y generar órdenes PS"
                                            Click="BtnConfirmarPS_Click"
                                            HorizontalAlignment="Right"
                                            Width="260" Height="36"
                                            Background="#FF9800" Foreground="White"
                                            BorderBrush="#FF9800" FontWeight="Bold"
                                            Cursor="Hand"/>

                                </Grid>

                            </Grid>

                        </TabItem>

                    </TabControl>

                </Grid>

            </DockPanel>
        </Border>
    </Grid>

</Window>
