<Window x:Class="recTivo.Frontend.Dialogos.Articulos.DialogoModificarArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MODIFICAR ARTÍCULO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="30">
                    <StackPanel>

                        <!-- FASE 1: Seleccionar código -->
                        <TextBlock Text="Selecciona código:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding CodigosArticulos}"
                                  SelectedItem="{Binding CodigoSeleccionado}"
                                  Width="200"
                                  Height="30"
                                  Margin="0,5"/>

                        <Button Content="Cargar artículo"
                                x:Name="btnCargarArticulo"
                                Click="btnCargarArticulo_Click"
                                Width="150"
                                Height="30"
                                Margin="0,10,0,20"
                                Background="#E0E0E0"
                                Foreground="#FF9800"
                                FontWeight="Bold" Cursor="Hand"/>

                        <!-- FASE 2: Datos del artículo -->
                        <StackPanel x:Name="panelDatos" Visibility="Hidden">

                            <TextBlock Text="Código:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" Height="30" Margin="0,5"/>

                            <TextBlock Text="Descripción 1:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Descrip, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" Height="30" Margin="0,5"/>

                            <TextBlock Text="Descripción 2:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Descrip2, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" Height="30" Margin="0,5"/>

                            <TextBlock Text="PVP:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Pvp, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="30" Margin="0,5"/>

                            <TextBlock Text="Stock:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="30" Margin="0,5"/>
                            
                            <TextBlock Text="Precio compra:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding PrecioCompra, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100" Height="30" Margin="0,5"/>

                            <Button Content="Guardar cambios"
                                    x:Name="btnModificarArticulo"
                                    Click="btnModificarArticulo_Click"
                                    Width="160"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0"
                                    Background="#E0E0E0"
                                    Foreground="#FF9800"
                                    FontWeight="Bold"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
