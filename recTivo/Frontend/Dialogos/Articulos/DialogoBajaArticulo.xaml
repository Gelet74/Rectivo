<Window x:Class="recTivo.Frontend.Dialogos.Articulos.DialogoBajaArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsa ESC para volver atrás"
        Height="250" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="BAJA ARTÍCULO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                
                <Grid Margin="30">
                    <StackPanel>
                        <TextBlock Text="Código del artículo:" Foreground="#FF9800"/>
                        <ComboBox x:Name="cmbCodigoArticulo"
                                  HorizontalAlignment="Left"
                                  Margin="0,10,0,0"
                                  ItemsSource="{Binding CodigosArticulos}"
                                  SelectedItem="{Binding CodigoSeleccionado, Mode=TwoWay}"
                                  Height="30"
                                  Width="200"/>
                    </StackPanel>

                    <Button Content="Dar de baja artículo"
                            x:Name="btnBajaArticulo"
                            Click="btnBajaArticulo_Click"
                            Height="30" Width="200"
                            HorizontalAlignment="Left"
                            Margin="0,0,50,23"
                            VerticalAlignment="Bottom"
                            Background="#E0E0E0"
                            Foreground="#ff9800"
                            FontWeight="Bold"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
