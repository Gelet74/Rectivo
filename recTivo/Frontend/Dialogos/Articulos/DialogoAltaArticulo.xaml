<Window x:Class="recTivo.Frontend.Dialogos.Articulos.DialogoAltaArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="350" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F44336"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,-3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA ARTÍCULO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="30,20,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Label Código -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: TextBox Código -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Error Código -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Label Descrip -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: TextBox Descrip -->
                        <RowDefinition Height="Auto"/>
                        <!-- 5: Error Descrip -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: Label Descrip2 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 7: TextBox Descrip2 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 8: Label PVP -->
                        <RowDefinition Height="Auto"/>
                        <!-- 9: TextBox PVP + Botón -->
                    </Grid.RowDefinitions>

                    <!-- CÓDIGO -->
                    <TextBlock Text="Código:" Foreground="#FF9800" Grid.Row="0"/>
                    <TextBox x:Name="txtCodigo"
                             Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.ColumnSpan="2"
                             HorizontalAlignment="Left"
                             Height="30" Margin="0,5,0,2" Width="414"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               Text="{Binding ErrorCodigo}"
                               Style="{StaticResource ErrorText}"/>

                    <!-- DESCRIPCIÓN 1 -->
                    <TextBlock Text="Descripción 1:" Foreground="#FF9800" Grid.Row="3"/>
                    <TextBox x:Name="txtDescrip"
                             Text="{Binding Descrip, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="4" Grid.ColumnSpan="2"
                             HorizontalAlignment="Left"
                             Height="30" Margin="0,5,0,2" Width="414"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                               Text="{Binding ErrorDescrip}"
                               Style="{StaticResource ErrorText}"/>

                    <!-- DESCRIPCIÓN 2 -->
                    <TextBlock Text="Descripción 2:" Foreground="#FF9800" Grid.Row="6"/>
                    <TextBox Text="{Binding Descrip2, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="7" Grid.ColumnSpan="2"
                             HorizontalAlignment="Left"
                             Height="30" Margin="0,5,0,8" Width="414"/>

                    <!-- PVP + BOTÓN -->
                    <TextBlock Text="PVP:" Foreground="#FF9800" Grid.Row="8"/>
                    <TextBox Text="{Binding Pvp, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="9"
                             HorizontalAlignment="Left"
                             Height="30" Margin="0,5,0,0" Width="100"/>

                    <Button Grid.Column="1" Grid.Row="9"
                            Content="Dar de alta artículo"
                            x:Name="btnAltaArticulo"
                            Click="btnAltaArticulo_Click"
                            IsEnabled="{Binding PuedeGuardar}"
                            BorderBrush="#FF5722"
                            Background="#E0E0E0"
                            Foreground="#FF5722"
                            Height="30" Width="180"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
