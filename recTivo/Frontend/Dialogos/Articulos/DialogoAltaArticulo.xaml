<Window x:Class="recTivo.Frontend.Dialogos.Articulos.DialogoAltaArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="350" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA ARTÍCULO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Código:" Foreground="#FF9800"/>
                    <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="1"
                                 HorizontalAlignment="Left"
                                 Height="30" 
                                 Margin="0,5" 
                                 Width="450"/>

                    <TextBlock Text="Descripción 1:"
                                   Grid.Row="2"
                                   Foreground="#FF9800"/>
                    <TextBox Text="{Binding Descrip, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"
                                 Height="30" 
                                 Margin="0,5,0,5" 
                                 Width="414"/>

                    <TextBlock Text="Descripción 2:"
                                   Grid.Row="4"
                                   Foreground="#FF9800"/>
                    <TextBox Text="{Binding Descrip2, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Grid.ColumnSpan="2"
                                 Grid.Row="5"
                                 Height="30"
                                 Margin="0,5" 
                                 Width="414"/>

                    <TextBlock Text="PVP:" 
                                   Grid.Row="6"
                                   Foreground="#FF9800"/>
                    <TextBox Text="{Binding Pvp, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Grid.Row="7"
                                 Height="30" 
                                 Margin="0,5"
                                 Width="100"/>

                    <Button Grid.Column="1"
                                Grid.Row="7"
                                Content="Dar de alta artículo"
                                x:Name="btnAltaArticulo"
                                Click="btnAltaArticulo_Click"
                                Height="30" Width="180"
                                HorizontalAlignment="Right"
                                Margin="0,5,18,0"
                                VerticalAlignment="Top"
                                BorderBrush="#FF5722"
                                Background="#E0E0E0"
                                Foreground="#FF5722"
                                FontWeight="Bold"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
