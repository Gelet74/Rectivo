<Window x:Class="recTivo.Frontend.Dialogos.Ventas.DialogoPedidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Height="720" Width="1100">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="#E0E0E0"/>
            <Setter Property="RowBackground"            Value="#F5F5F5"/>
            <Setter Property="AlternatingRowBackground" Value="#E8E8E8"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="RowHeaderWidth"           Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="VENTAS — PEDIDOS"
                               Foreground="White" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Grid.Column="1" Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="20">
                    <TabControl x:Name="tabControl"
                                Background="#2D2D30"
                                BorderBrush="#FF9800" BorderThickness="0,2,0,0"
                                SelectionChanged="TabControl_SelectionChanged">

                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background"     Value="#3A3A3D"/>
                                <Setter Property="Foreground"     Value="#AAA"/>
                                <Setter Property="FontWeight"     Value="Bold"/>
                                <Setter Property="FontSize"       Value="13"/>
                                <Setter Property="Padding"        Value="18,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF9800"/>
                                        <Setter Property="Foreground" Value="#1E1E1E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  PESTAÑA 1: CREAR PEDIDO                      -->
                        <!-- ══════════════════════════════════════════════ -->
                        <TabItem Header="🛒  Crear pedido">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- FILA 1: Artículos PT + líneas pedido -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LISTBOX PT -->
                                    <Border Grid.Column="0" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Artículos PT:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBox x:Name="txtFiltroPT"
                                                     Text="{Binding FiltroPT, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28" Margin="0,0,0,8"/>
                                            <ListBox x:Name="lstPT"
                                                     ItemsSource="{Binding ArticulosPTFiltrados}"
                                                     Background="Transparent" BorderThickness="0"
                                                     MaxHeight="300"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox x:Name="chkPT" Foreground="White" Margin="0,3"
                                                                  Checked="ChkPT_Checked" Unchecked="ChkPT_Unchecked">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Codigo}" FontWeight="Bold" Foreground="White"/>
                                                                <TextBlock Text="{Binding descrip}"  Foreground="#AAAAAA" FontSize="11"/>
                                                                <TextBlock Text="{Binding descrip2}" Foreground="#AAAAAA" FontSize="11"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding"    Value="2"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- LÍNEAS DEL PEDIDO -->
                                    <Border Grid.Column="2" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Líneas del pedido — edita las cantidades:"
                                                       Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <DataGrid x:Name="dgLineas"
                                                      ItemsSource="{Binding LineasPedido}"
                                                      IsReadOnly="False" MaxHeight="320"
                                                      CellEditEnding="DgLineas_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Código"
                                                                        Binding="{Binding Codigo}"
                                                                        Width="110" IsReadOnly="True" FontWeight="SemiBold"/>
                                                    <DataGridTextColumn Header="Descripción"
                                                                        Binding="{Binding Descripcion}"
                                                                        Width="*" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Descripción 2"
                                                                        Binding="{Binding Descripcion2}"
                                                                        Width="*" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Cantidad"
                                                                        Binding="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"
                                                                        Width="70"/>
                                                    <DataGridTextColumn Header="PVP unit."
                                                                        Binding="{Binding PrecioUnitario, StringFormat={}{0:0.00} €}"
                                                                        Width="90" IsReadOnly="True"/>
                                                    <DataGridTextColumn Header="Subtotal"
                                                                        Binding="{Binding Subtotal, StringFormat={}{0:0.00} €}"
                                                                        Width="90" IsReadOnly="True"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Text="Haz doble clic en Cantidad para editarla."
                                                       Foreground="#888" FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- FILA 2: Cliente + fecha + total -->
                                <Border Grid.Row="1" Background="#3A3A3D" CornerRadius="4"
                                        Padding="16,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Buscador cliente -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="200">
                                            <TextBlock Text="Buscar cliente:" Foreground="#FF9800" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding FiltroCliente, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="28" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cmbCliente"
                                                      ItemsSource="{Binding ClientesFiltrados}"
                                                      SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                                                      Height="28" Background="#E0E0E0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding Nombre}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding Apellido1}"/>
                                                            <Run Text=" — DNI: "/>
                                                            <Run Text="{Binding Dni}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Fecha entrega -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Fecha entrega prevista:" Foreground="#FF9800" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding FechaEntrega, Mode=TwoWay}"
                                                        Width="160" Height="30" Background="#E0E0E0"/>
                                        </StackPanel>

                                        <!-- Total -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="TOTAL PEDIDO" Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TotalPedido, StringFormat={}{0:0.00} €}"
                                                       Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Botón crear -->
                                        <Button Grid.Column="6"
                                                Content="✔  Crear pedido"
                                                Click="BtnCrearPedido_Click"
                                                Width="180" Height="40"
                                                Background="#FF9800" Foreground="White"
                                                BorderBrush="#FF9800" FontWeight="Bold"
                                                VerticalAlignment="Center" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ══════════════════════════════════════════════ -->
                        <!--  PESTAÑA 2: LISTAR / CERRAR PEDIDOS           -->
                        <!-- ══════════════════════════════════════════════ -->
                        <TabItem Header="📋  Listar pedidos">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Filtros -->
                                <Border Grid.Row="0" Background="#3A3A3D" CornerRadius="4"
                                        Padding="16,10" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Estado:" Foreground="#FF9800"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding OpcionesEstado}"
                                                  SelectedItem="{Binding FiltroEstadoPedido, Mode=TwoWay}"
                                                  Width="120" Height="28" Background="#E0E0E0" Margin="0,0,20,0"/>

                                        <TextBlock Text="Cliente / Nº:" Foreground="#FF9800"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding FiltroCodigoPedido, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="160" Height="28"/>
                                    </StackPanel>
                                </Border>

                                <!-- Tabla pedidos -->
                                <Border Grid.Row="1" Background="#3A3A3D" CornerRadius="4" Padding="12">
                                    <DataGrid x:Name="dgPedidos"
                                              ItemsSource="{Binding PedidosFiltrados}"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectedItem="{Binding PedidoSeleccionado, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nº"        Binding="{Binding IdPedido}"  Width="55" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Cliente"   Binding="{Binding Cliente}"   Width="*"/>
                                            <DataGridTextColumn Header="Fecha"     Binding="{Binding Fecha}"     Width="100"/>
                                            <DataGridTextColumn Header="Entrega"   Binding="{Binding Entrega}"   Width="100"/>
                                            <DataGridTextColumn Header="Estado"    Binding="{Binding Estado}"    Width="100"/>
                                            <DataGridTextColumn Header="Total"     Binding="{Binding Total, StringFormat={}{0:0.00} €}" Width="100"/>
                                        </DataGrid.Columns>

                                        <!-- Colorear fila Entregado en verde -->
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Entregado">
                                                        <Setter Property="Background" Value="#C8E6C9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                </Border>

                                <!-- Botón cerrar pedido -->
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Button Content="📦  Cerrar pedido seleccionado (entregar)"
                                            Click="BtnCerrarPedido_Click"
                                            HorizontalAlignment="Right"
                                            Width="300" Height="38"
                                            Background="#FF9800" Foreground="White"
                                            BorderBrush="#FF9800" FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
