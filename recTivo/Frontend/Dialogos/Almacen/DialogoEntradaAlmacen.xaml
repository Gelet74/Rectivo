<Window x:Class="recTivo.Frontend.Dialogos.DialogoEntradaAlmacen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsa ESC para volver atrás"
        Height="500" Width="600"
        ResizeMode="NoResize"
        x:Name="DialEntradaAlmacen"
        
        Loaded="DialEntradaAlmacen_Loaded"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">
    

            <Window.Resources >

                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>


                <Style TargetType="ComboBox">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </Window.Resources>

    <Grid Cursor="" >
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ENTRADA ALMACÉN"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>
                <Grid Margin="30">
                    <StackPanel>
                        <TextBlock Text="Código del artículo:" Foreground="#FF9800"/>
                        <ComboBox x:Name="cmbCodigo" 
                      Height="30" 
                      Margin="0,5"
                      DisplayMemberPath="Codigo"
                      SelectionChanged="cmbCodigo_SelectionChanged"
                      Width="180"
                      HorizontalAlignment="Left"/>

                        <TextBlock Text="Descripción 1:" Foreground="#FF9800"/>
                        <ComboBox x:Name="cmbDescrip1" 
                      Height="30" 
                      HorizontalAlignment="Left"
                      Margin="0,5"
                      SelectionChanged="cmbDescrip1_SelectionChanged" 
                      Cursor="Hand"
                      Width="180"/>

                        <TextBlock Text="Descripción 2:" Foreground="#FF9800"/>
                        <ComboBox x:Name="cmbDescrip2" 
                      Height="30" 
                      HorizontalAlignment="Left"
                      Margin="0,5"
                      SelectionChanged="cmbDescrip2_SelectionChanged" 
                      Cursor="Hand"
                      Width="180"/>

                        <TextBlock Text="Cantidad:" Foreground="#FF9800"/>
                        <TextBox x:Name="txtCantidad" 
                     Height="30" 
                     Margin="0,5" 
                     Width="180"
                     HorizontalAlignment="Left"/>

                        <TextBlock Text="Letra pasillo:" Foreground="#FF9800"/>
                        <TextBox x:Name="txtPasillo" 
                     Height="30" 
                     Margin="0,5"
                     Width="180"
                     HorizontalAlignment="Left"/>

                        <TextBlock Text="Número estantería:" Foreground="#FF9800"/>
                        <TextBox x:Name="txtEstanteria" 
                     Height="30" 
                     Margin="0,5"
                     Width="180"
                     HorizontalAlignment="Left"/>

                        <TextBlock Text="Hueco:" Foreground="#FF9800"/>
                        <TextBox x:Name="txtHueco" 
                     Height="30" 
                     Margin="0,5"
                     Width="180"
                     HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Content="Añadir al almacén"
                x:Name="btnAnadirAlmacen"
                Click="btnAnadirAlmacen_Click"
                Height="30" Width="180"
                HorizontalAlignment="Right"
                Margin="0,0,50,12"
                VerticalAlignment="Bottom"
                Background="#E0E0E0"
                Foreground="#ff9800"
                FontWeight="Bold"/>

                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
