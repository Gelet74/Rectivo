<Window x:Class="recTivo.Frontend.Dialogos.DialogoSalidaAlmacen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsa ESC para volver atrás"
        Height="350" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SALIDA ALMACÉN"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="30">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA IZQUIERDA -->
                        <StackPanel Grid.Column="0" Margin="10,0,10,0">

                            <TextBlock Text="Código del artículo:" Foreground="#FF9800"/>
                            <ComboBox ItemsSource="{Binding MVArticulo.CodigosLista}"
                                      SelectedItem="{Binding MVArticulo.FiltroCodigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Height="30"
                                      Margin="0,5"
                                      Width="180"
                                      HorizontalAlignment="Left"/>

                            <TextBlock Text="Descripción 1:" Foreground="#FF9800"/>
                            <ComboBox ItemsSource="{Binding MVArticulo.DescripcionesLista}"
                                      SelectedItem="{Binding MVArticulo.FiltroDescripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Height="30"
                                      Margin="0,5"
                                      Width="180"
                                      HorizontalAlignment="Left"/>

                            <TextBlock Text="Descripción 2:" Foreground="#FF9800"/>
                            <ComboBox ItemsSource="{Binding MVArticulo.Descripciones2Lista}"
                                      SelectedItem="{Binding MVArticulo.FiltroDescripcion2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" 
                                      Height="30"   
                                      Margin="0,5"
                                      Width="180"
                                      HorizontalAlignment="Left"/>

                            <TextBlock Text="Cantidad:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Cantidad, Mode=TwoWay}"
                                     Height="30"
                                     Margin="0,5"
                                     Width="180"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- COLUMNA DERECHA -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">

                            <TextBlock Text="Letra pasillo:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Pasillo, Mode=TwoWay}"
                                     Height="30"
                                     Margin="0,5"
                                     Width="180"
                                     HorizontalAlignment="Left"/>

                            <TextBlock Text="Número estantería:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Estanteria, Mode=TwoWay}"
                                     Height="30"
                                     Margin="0,5"
                                     Width="180"
                                     HorizontalAlignment="Left"/>

                            <TextBlock Text="Hueco:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Hueco, Mode=TwoWay}"
                                     Height="30"
                                     Margin="0,5"
                                     Width="180"
                                     HorizontalAlignment="Left"/>

                            <Button Content="Restar del almacén"
                                    Click="btnRestarAlmacen_Click"
                                    Height="30" Width="180"
                                    HorizontalAlignment="Left"
                                    Margin="0,20,0,0"
                                    BorderBrush="#FF5722"
                                    VerticalAlignment="Bottom"
                                    Background="#E0E0E0"
                                    Foreground="#FF5722"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
