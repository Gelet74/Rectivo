<Window x:Class="recTivo.Frontend.Dialogos.DialogoSalidaAlmacen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsa ESC para volver atrás"
        Height="420" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>

        <!-- TextBox estándar -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
        </Style>

        <!-- ComboBox estándar -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <!-- Estilo para mensajes de error -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#F44336"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Margin"      Value="0,-3,0,3"/>
        </Style>

        <!-- Botón estándar -->
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#555555"/>
            <Setter Property="Foreground"  Value="#999999"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Width"       Value="180"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="#FF9800"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SALIDA ALMACÉN" Foreground="White"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás" Foreground="White"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Grid.Column="1" Margin="0,0,10,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA -->
                    <StackPanel Grid.Column="0" Margin="10,0,10,0">

                        <TextBlock Text="Código del artículo:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding MVArticulo.CodigosLista}"
                                  SelectedItem="{Binding MVArticulo.FiltroCodigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,5" Width="180" HorizontalAlignment="Left"/>

                        <TextBlock Text="Descripción 1:" Foreground="#FF9800" Margin="0,15"/>
                        <ComboBox ItemsSource="{Binding MVArticulo.DescripcionesLista}"
                                  SelectedItem="{Binding MVArticulo.FiltroDescripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,-10,0,5" Width="180" HorizontalAlignment="Left"/>

                        <TextBlock Text="Descripción 2:" Foreground="#FF9800" Margin="0,15"/>
                        <ComboBox ItemsSource="{Binding MVArticulo.Descripciones2Lista}"
                                  SelectedItem="{Binding MVArticulo.FiltroDescripcion2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Margin="0,-10,0,5" Width="180" HorizontalAlignment="Left"/>

                        <TextBlock Text="Cantidad:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5" Width="180" Height="30" HorizontalAlignment="Left"
                                 PreviewTextInput="TextBox_SoloNumeros"/>
                        <TextBlock Text="{Binding ErrorCantidad}" Style="{StaticResource ErrorText}"/>

                    </StackPanel>

                    <!-- COLUMNA DERECHA -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">

                        <TextBlock Text="Letra pasillo:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Pasillo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5" Width="180" Height="30" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ErrorPasillo}" Style="{StaticResource ErrorText}"/>

                        <TextBlock Text="Número estantería:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Estanteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5" Width="180" Height="30" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ErrorEstanteria}" Style="{StaticResource ErrorText}"/>

                        <TextBlock Text="Hueco:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Hueco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5" Width="180" Height="30" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ErrorHueco}" Style="{StaticResource ErrorText}"/>

                        <Button Content="RESTAR DEL ALMACÉN"
                                Click="btnRestarAlmacen_Click"
                                IsEnabled="{Binding EsValido}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
