<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoAltaEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="400" Width="600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Validation.Error="OnErrorEvent">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <AdornedElementPlaceholder/>
                            <TextBlock Text="{Binding [0].ErrorContent}"
                                       Foreground="Red"
                                       FontSize="10"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                    Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA EMPLEADO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="30,20,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- COLUMNA IZQUIERDA -->
                    <StackPanel Grid.Column="0" Margin="10,0,10,0">

                        <TextBlock Text="Apellidos:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Empleado.Apellidos,
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,2,0,8" Width="180"/>

                        <TextBlock Text="Nombre:" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding Empleado.Nombre,
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,2,0,8" Width="180"/>

                        <TextBlock Text="DNI:" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding Empleado.Dni,
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,2,0,8" Width="180"/>

                        <TextBlock Text="Puesto:" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <ComboBox ItemsSource="{Binding ListaRoles}"
                                  SelectedItem="{Binding Empleado.Rol,
                                                ValidatesOnDataErrors=True,
                                                NotifyOnValidationError=True,
                                                UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  Height="30" Margin="0,2,0,8" Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreRol}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </StackPanel>

                    <!-- COLUMNA DERECHA -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">

                        <TextBlock Text="Usuario:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Empleado.Username,
                                        ValidatesOnDataErrors=True,
                                        NotifyOnValidationError=True,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Height="30" Margin="0,2,0,8" Width="180"/>

                        <TextBlock Text="Contraseña:" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <PasswordBox x:Name="txtPassword"
                                     PasswordChanged="txtPassword_PasswordChanged"
                                     HorizontalAlignment="Left"
                                     Height="30" Margin="0,2,0,8" Width="180"/>

                        <TextBlock Text="Estado:" Foreground="#FF9800" Margin="0,10,0,0"/>
                        <ComboBox ItemsSource="{Binding Estados}"
                                  SelectedItem="{Binding Estado, Mode=TwoWay}"
                                  Height="30" Margin="0,2,0,8" Width="180"
                                  HorizontalAlignment="Left"
                                  Background="White" Foreground="Black">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Dar de alta"
                                Click="btnAltaEmpleado_Click"
                                Height="30" Width="180"
                                Margin="0,26,0,0"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding HasNoErrors}"/>
                    </StackPanel>

                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
