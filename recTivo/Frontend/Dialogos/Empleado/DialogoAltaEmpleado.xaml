<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoAltaEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="500" Width="600"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">
               
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA EMPLEADO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>
                
                <Grid Margin="30">
                    <StackPanel>

                        <TextBlock Text="Apellidos:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Apellidos}" 
                                 Height="30" 
                                 Margin="0,5" 
                                 HorizontalAlignment="Left"
                                 Width="300"/>

                        <TextBlock Text="Nombre:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Nombre}"
                                 Height="30" 
                                 Margin="0,5" 
                                 HorizontalAlignment="Left"
                                 Width="300"/>

                        <TextBlock Text="DNI:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Dni}" 
                                 Height="30" 
                                 Margin="0,5"
                                 HorizontalAlignment="Left"
                                 Width="300"/>

                        <TextBlock Text="Usuario:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Username}" 
                                 Height="30" 
                                 Margin="0,5" 
                                 HorizontalAlignment="Left"
                                 Width="300"/>

                        <TextBlock Text="Contraseña:" Foreground="#FF9800"/>
                        <TextBox Text="{Binding Password}" 
                                 Height="30" 
                                 Margin="0,5" 
                                 HorizontalAlignment="Left"
                                 Width="300"/>

                        <TextBlock Text="Puesto:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaRoles}"
                                  SelectedValue="{Binding IdRol}"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="Id"
                                  HorizontalAlignment="Left"
                                  Height="30"
                                  Margin="0,5"
                                  Width="300"/>
                    </StackPanel>

                    <Button Content="Dar de alta"
                            Click="btnAltaEmpleado_Click"
                            Command="{Binding GuardarNuevoCommand}"
                            Height="30" Width="200"
                            Margin="0,0,10,10"
                            Background="#E0E0E0"
                            Foreground="#ff9800"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"/>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
