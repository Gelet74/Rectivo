<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoBajaEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulsa ESC para volver atrás"
        Height="350" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="BAJA EMPLEADO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="30">
                    <StackPanel>

                        <!-- NOMBRE -->
                        <TextBlock Text="Nombre:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaEmpleados}"
                                  SelectedValue="{Binding IdEmpleadoSeleccionado}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nombre"
                                  HorizontalAlignment="Left"
                                  Height="30"
                                  Width="300"
                                  Margin="0,5"/>

                        <!-- APELLIDOS -->
                        <TextBlock Text="Apellidos:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaEmpleados}"
                                  SelectedValue="{Binding IdEmpleadoSeleccionado}"
                                  HorizontalAlignment="Left"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Apellidos"
                                  Height="30"
                                  Width="300"
                                  Margin="0,5"/>

                        <!-- DNI -->
                        <TextBlock Text="DNI:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaEmpleados}"
                                  SelectedValue="{Binding IdEmpleadoSeleccionado}"
                                  HorizontalAlignment="Left"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Dni"
                                  Height="30"
                                  Width="300"
                                  Margin="0,5"/>

                    </StackPanel>

                    <!-- BOTÓN -->
                    <Button Content="Dar de baja empleado"
                            Click="btnBajaEmpleado_Click"
                            Height="30" Width="200"                            
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#E0E0E0"
                            Foreground="#ff9800"
                            FontWeight="Bold"/>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
