<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoModificarEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MODIFICAR EMPLEADO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="30">
                    <StackPanel>

                        <TextBlock Text="Selecciona Nombre:" Foreground="#FF9800"/>

                        <ComboBox ItemsSource="{Binding NombresEmpleados}"
                                  SelectedItem="{Binding NombreEmpleadoSeleccionado}"
                                  Width="200" Height="30"
                                  HorizontalAlignment="Center"
                                  Margin="0,5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="Black"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Cargar empleado"
                                x:Name="btnCargarEmpleado"
                                Click="btnCargarEmpleado_Click"
                                Width="150" Height="30"
                                Margin="0,10,0,20"
                                HorizontalAlignment="Center"/>

                        <!-- PANEL DE DATOS -->
                        <StackPanel x:Name="panelDatos" Visibility="Hidden">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- COLUMNA IZQUIERDA -->
                                <TextBlock Text="Nombre:" Foreground="#FF9800"
                                           Grid.Column="0" Grid.Row="0" Margin="0,5,10,0"/>
                                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="0" Grid.Row="1"
                                         Height="30" Margin="0,5,10,5"/>

                                <TextBlock Text="DNI:" Foreground="#FF9800"
                                           Grid.Column="0" Grid.Row="2" Margin="0,5,10,0"/>
                                <TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="0" Grid.Row="3"
                                         Height="30" Margin="0,5,10,5"/>

                                <TextBlock Text="Usuario:" Foreground="#FF9800"
                                           Grid.Column="0" Grid.Row="4" Margin="0,5,10,0"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="0" Grid.Row="5"
                                         Height="30" Margin="0,5,10,5"/>

                                <TextBlock Text="Estado:" Foreground="#FF9800"
                                           Grid.Column="0" Grid.Row="6" Margin="0,5,10,0"/>
                                <ComboBox ItemsSource="{Binding Estados}"
                                          SelectedItem="{Binding Estado}"
                                          Grid.Column="0" Grid.Row="7"
                                          Height="30" Margin="0,5,10,5">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="Black"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- COLUMNA DERECHA -->
                                <TextBlock Text="Apellidos:" Foreground="#FF9800"
                                           Grid.Column="1" Grid.Row="0" Margin="10,5,0,0"/>
                                <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="1" Grid.Row="1"
                                         Height="30" Margin="10,5,0,5"/>

                                <TextBlock Text="Rol:" Foreground="#FF9800"
                                           Grid.Column="1" Grid.Row="2" Margin="10,5,0,0"/>
                                <ComboBox ItemsSource="{Binding ListaRoles}"
                                          SelectedItem="{Binding RolSeleccionado}"
                                          Grid.Column="1" Grid.Row="3"
                                          Height="30" Margin="10,5,0,5">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NombreRol}" Foreground="Black"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Contraseña:" Foreground="#FF9800"
                                           Grid.Column="1" Grid.Row="4" Margin="10,5,0,0"/>
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="1" Grid.Row="5"
                                         Height="30" Margin="10,5,0,5"/>

                                <!-- BOTÓN GUARDAR -->
                                <Button Content="Guardar cambios"
                                        x:Name="btnModificarEmpleado"
                                        Click="btnModificarEmpleado_Click"
                                        Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2"
                                        Width="160" Height="30"
                                        HorizontalAlignment="Center"
                                        Margin="0,20,0,0"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
