<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoModificarEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MODIFICAR EMPLEADO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="30">
                    <StackPanel>

                        <TextBlock Text="Selecciona Nombre:" Foreground="#FF9800"/>
                        <ComboBox ItemsSource="{Binding ListaEmpleados}"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedItem="{Binding EmpleadoSeleccionado}"
                                  Width="200"
                                  Height="30"
                                  HorizontalAlignment="Left"
                                  Margin="0,5"/>

                        <Button Content="Cargar empleado"
                                x:Name="btnCargarEmpleado"
                                Click="btnCargarEmpleado_Click"
                                Width="150"
                                Height="30"
                                Margin="0,10,0,20"
                                Background="#E0E0E0"
                                Foreground="#FF9800"
                                HorizontalAlignment="Left"
                                FontWeight="Bold" Cursor="Hand"/>

                        <StackPanel x:Name="panelDatos" Visibility="Hidden">

                            <TextBlock Text="Nombre:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" 
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     Margin="0,5"/>

                            <TextBlock Text="Apellidos:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300" 
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     Margin="0,5"/>

                            <TextBlock Text="DNI:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged}"
                                     Width="150" 
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     Margin="0,5"/>

                            <TextBlock Text="Rol:" Foreground="#FF9800"/>
                            <ComboBox ItemsSource="{Binding ListaRoles}"
                                      DisplayMemberPath="NombreRol"
                                      SelectedItem="{Binding RolSeleccionado}"
                                      Width="200" 
                                      Height="30"
                                      HorizontalAlignment="Left"
                                      Margin="0,5"/>

                            <TextBlock Text="Usuario:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" 
                                     Height="30" 
                                     HorizontalAlignment="Left"
                                     Margin="0,5"/>

                            <TextBlock Text="Contraseña:" Foreground="#FF9800"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" 
                                     Height="30"
                                     HorizontalAlignment="Left"
                                     Margin="0,5"/>

                            <TextBlock Text="Estado:" Foreground="#FF9800"/>
                            <ComboBox ItemsSource="{Binding Estados}"
                                      SelectedItem="{Binding Estado}"
                                      Width="150" 
                                      Height="30"
                                      HorizontalAlignment="Left"
                                      Margin="0,5"/>

                            <Button Content="Guardar cambios"
                                    x:Name="btnModificarEmpleado"
                                    Click="btnModificarEmpleado_Click"
                                    Width="160"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0"
                                    Background="#E0E0E0"
                                    Foreground="#FF9800"
                                    FontWeight="Bold"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
