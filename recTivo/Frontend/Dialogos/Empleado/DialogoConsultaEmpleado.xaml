<Window x:Class="recTivo.Frontend.Dialogos.Empleado.DialogoConsultaEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550" Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#3A3A3D"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderBrush"     Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LISTAR EMPLEADOS"
                               Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Grid.Column="1" Margin="0,0,20,0"/>
                </Grid>

                <!-- DATAGRID -->
                <DataGrid Margin="20"
                          ItemsSource="{Binding ListaEmpleados}"
                          SelectedItem="{Binding EmpleadoSeleccionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          Background="#3A3A3D"
                          RowBackground="#2D2D30"
                          Foreground="White"
                          AlternatingRowBackground="#333337"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#444444"
                          BorderThickness="0"
                          SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre"     Binding="{Binding Nombre}"        Width="100"/>
                        <DataGridTextColumn Header="Apellidos"  Binding="{Binding Apellidos}"     Width="130"/>
                        <DataGridTextColumn Header="DNI"        Binding="{Binding Dni}"           Width="110"/>
                        <DataGridTextColumn Header="Rol"        Binding="{Binding Rol.NombreRol}" Width="120"/>
                        <DataGridTextColumn Header="Usuario"    Binding="{Binding Username}"      Width="110"/>
                        <DataGridTextColumn Header="Contraseña" Binding="{Binding Password}"      Width="120"/>
                        <DataGridTextColumn Header="Estado"     Binding="{Binding Estado}"        Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </Border>
    </Grid>
</Window>
