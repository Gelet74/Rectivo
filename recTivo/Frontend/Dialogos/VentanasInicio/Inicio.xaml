<Window x:Class="recTivo.Frontend.Dialogos.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="400" Width="600">

    <!-- SOLO AÑADIMOS ESTE BORDER -->
    <Border BorderBrush="#FF9800" BorderThickness="4" Background="White">

        <!-- TU CONTENIDO ORIGINAL SIN CAMBIAR -->
        <Grid>
            <!-- Logo centrado -->
            <Image Source="/Recursos/Iconos/rectivo_logo_fondo.png"
                   Width="250"
                   Height="250"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="2"
                                                 Duration="0:0:4"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 From="0.2" To="3.8"
                                                 Duration="0:0:4"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 From="0.2" To="3.8"
                                                 Duration="0:0:4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>

            <!-- Texto corporativo -->
            <TextBlock Text="recTivo"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#ffb607"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,0"/>
        </Grid>

    </Border>
</Window>
