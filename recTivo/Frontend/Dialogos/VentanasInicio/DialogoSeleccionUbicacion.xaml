<Window x:Class="recTivo.Frontend.Dialogos.VentanasInicio.DialogoSeleccionUbicacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Height="420" Width="500">

    <Border BorderBrush="#FF9800" BorderThickness="4" Background="#2D2D30">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="SELECCIONAR UBICACIÓN"
                       Foreground="#FF9800" FontSize="15" FontWeight="Bold"
                       TextAlignment="Center" Margin="0,0,0,16"/>

            <!-- Info artículo -->
            <Border Grid.Row="1" Background="#3A3A3D" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="txbArticulo"
                               Foreground="White" FontWeight="Bold" FontSize="13"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="txbNecesario"
                               Foreground="#AAAAAA" FontSize="11"
                               TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Lista de ubicaciones -->
            <Border Grid.Row="2" Background="#3A3A3D" CornerRadius="4" Padding="8">
                <ListBox x:Name="lstUbicaciones"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="brd" Background="Transparent"
                                                CornerRadius="3" Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="brd" Property="Background" Value="#FF9800"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="brd" Property="Background" Value="#4A4A4D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Etiqueta}"
                                           Foreground="White" FontSize="13"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StockTexto}"
                                           Foreground="#AAAAAA" FontSize="12"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Botones -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="btnConfirmar"
                        Content="Confirmar"
                        Width="120" Height="34"
                        Background="#FF9800" Foreground="White"
                        FontWeight="Bold" Cursor="Hand"
                        Click="BtnConfirmar_Click" Margin="0,0,12,0"/>
                <Button x:Name="btnCancelar"
                        Content="Cancelar pedido"
                        Width="140" Height="34"
                        Background="#E0E0E0" Foreground="Black"
                        FontWeight="Bold" Cursor="Hand"
                        Click="BtnCancelar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
