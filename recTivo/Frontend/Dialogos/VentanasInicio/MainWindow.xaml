<mah:MetroWindow x:Class="recTivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:recTivo"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="rectivo" 
        Height="450" Width="950" Cursor="">
    <Grid Background="#2D2D30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Recursos/Iconos/rectivo_logo_sintexto.png" 
                   Width="40" 
                   Height="40"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="40,10,0,0"/>

            <TextBlock Grid.Row="1"
                       Text="recTivo" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#ff9800"
                       HorizontalAlignment="Left" 
                       Margin="20,0,5,0"
                       VerticalAlignment="Center"/>

            <Separator Grid.Row="2"
                       Grid.Column="0"
                       Margin="5,5,20,5"
                       Background="#ff9800"
                       Width="120"
                       Height="2"
                       HorizontalAlignment="Left"/>

            <Button Grid.Row="3"
                    Width="120"
                    x:Name="almacen"
                    Click="Almacen_Click"
                    Background="#ff9800"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal" >
                    <Image Source="/Recursos/Iconos/Almacen.png" 
                           Width="24" 
                           Height="24"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0"/>
                    <TextBlock Text="Almacén" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               Foreground="White" 
                               Height="15" Width="50"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="4"
                    Width="120"
                    x:Name="articulos"
                    Click="Articulos_Click"
                    Background="#ff9800"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Recursos/Iconos/Articulos.png" 
                           Width="24" 
                           Height="24"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0"/>
                    <TextBlock Text="Artículos" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               Foreground="White" 
                               Height="15" Width="50"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="5"
                    Width="120"
                    x:Name="clientes"
                    Click="Clientes_Click"
                    Background="#ff9800"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Recursos/Iconos/Clientes.png" 
                           Width="24" 
                           Height="24"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0"/>
                    <TextBlock Text="Clientes" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               Foreground="White" 
                               Height="15" Width="50"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="6"
                    Width="120"
                   x:Name="empleados"
                   Click="empleados_Click"
                   Background="#ff9800"
                   BorderBrush="Transparent"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   HorizontalContentAlignment="Left"
                   VerticalContentAlignment="Center"
                   Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal" Width="107" Margin="-10,0,0,0">
                    <Image Source="/Recursos/Iconos/Empleado.png" 
                           Width="22" 
                           Height="22"
                           Margin="0,0,0,0"/>
                    <TextBlock Text="Empleados" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="6,0,0,0"
                               Foreground="White" 
                               Height="16" Width="68"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="7"
                    Width="120"
                    x:Name="ordenes"
                    Click="Ordenes_Click"
                    Background="#ff9800"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Recursos/Iconos/Ordenes.png" 
                           Width="24" 
                           Height="24"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0"/>
                    <TextBlock Text="Órdenes" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               Foreground="White" 
                               Height="15" Width="50"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="8"  
                    Width="120"
                    x:Name="ventas"
                    Click="Almacen_Click"
                    Background="#ff9800"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Cursor="Hand" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal" >
                    <Image Source="/Recursos/Iconos/Ventas.png" 
                           Width="24" 
                           Height="24"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0"/>
                    <TextBlock Text="Ventas" 
                               FontSize="12" 
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               Foreground="White" 
                               Height="15" Width="50"/>
                </StackPanel>
            </Button>

            <Button Grid.Row="9"  
        Width="120"
        x:Name="salir"
        Click="salir_Click"
        Background="#ff9800"
        BorderBrush="Transparent"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Left"
        HorizontalContentAlignment="Left"
        VerticalContentAlignment="Center"
        Cursor="Hand" Margin="5,130,0,0">
                <StackPanel Orientation="Horizontal" >
                    <Image Source="/Recursos/Iconos/salir.png" 
                           Width="40"                                
                           Height="30"
                           HorizontalAlignment="Left"
                           Margin="-10,0,0,0" Cursor=""/>
                    <TextBlock Text="Salir" 
                   FontSize="13" 
                   FontWeight="Bold"
                   Margin="5,0,0,0"
                   Foreground="White" 
                   Height="15" Width="50"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</mah:MetroWindow>
