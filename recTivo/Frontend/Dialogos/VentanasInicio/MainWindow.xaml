<mah:MetroWindow x:Class="recTivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:recTivo"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        WindowStyle="None"
        Icon="/Recursos/Iconos/rectivo_logo_fondo.png"         
        Height="600" Width="1000">

    <Grid Background="#2D2D30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================
             SIDEBAR IZQUIERDA
             ============================ -->
        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="#ff9800">

            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Left"
                        Width="170">

                <Image Source="/Recursos/Iconos/rectivo_logo_sintexto.png" 
                       Width="40"
                       Height="40" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left" 
                       Margin="45,10,0,0"/>

                <TextBlock Text="recTivo" FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Left" 
                           Margin="30,0,5,0" 
                           VerticalAlignment="Center"/>

                <Separator Margin="5,5,20,5" 
                           Background="White" 
                           Width="150" 
                           Height="8" 
                           HorizontalAlignment="Left"/>

                <!-- ============================
                     MENÚS
                     ============================ -->

                <!-- Almacén -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" 
                          Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Almacen.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Almacén" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="almacen"
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="almacen_SelectionChanged" 
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Entradas almacén" Padding="20 5"/>
                        <ListViewItem Content="Salidas almacén" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Artículos -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" 
                          Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Articulos.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Artículos" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="articulos" 
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="articulos_SelectionChanged" 
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                              Cursor="Hand">
                        <ListViewItem Content="Dar de alta" Padding="20 5"/>
                        <ListViewItem Content="Dar de baja" Padding="20 5"/>
                        <ListViewItem Content="Modificar" Padding="20 5"/>
                        <ListViewItem Content="Listar artículos" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Clientes -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" 
                          Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Clientes.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Clientes" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="clientes" 
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="clientes_SelectionChanged"
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Dar de alta" Padding="20 5"/>
                        <ListViewItem Content="Modificar" Padding="20 5"/>
                        <ListViewItem Content="Listar clientes" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Empleados -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Empleado.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Empleados" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="empleados" 
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="empleados_SelectionChanged" 
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Dar de alta" Padding="20 5"/>
                        <ListViewItem Content="Modificar" Padding="20 5"/>
                        <ListViewItem Content="Listar empleados" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Escandallos -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/escandallo.png" 
                                   Width="35" Height="35" Margin="-10,0,0,0"/>
                            <TextBlock Text="Escandallos" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="8,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="escandallos" 
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="escandallos_SelectionChanged" 
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Dar de alta" Padding="20 5"/>
                        <ListViewItem Content="Modificar" Padding="20 5"/>
                        <ListViewItem Content="Listar escandallo" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Órdenes -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" 
                          Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Ordenes.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Órdenes" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="ordenes" 
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              SelectionChanged="ordenes_SelectionChanged"
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Procesar orden" Padding="20 5"/>
                        <ListViewItem Content="Cerrar orden" Padding="20 5"/>
                        <ListViewItem Content="Listar órdenes" Padding="20 5"/>
                    </ListView>
                </Expander>

                <!-- Ventas -->
                <Expander HorizontalAlignment="Left" 
                          IsExpanded="False" 
                          Width="170" 
                          Style="{StaticResource MaterialDesignExpander}" 
                          Foreground="White" 
                          Background="#ff9800" 
                          Cursor="Hand">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Recursos/Iconos/Ventas.png" 
                                   Width="30" Height="30" Margin="-5,0,0,0"/>
                            <TextBlock Text="Ventas" 
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Margin="10,0,0,0"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListView x:Name="ventas" 
                              SelectionChanged="ventas_SelectionChanged"
                              PreviewKeyDown="Menu_PreviewKeyDown"
                              Style="{StaticResource MaterialDesignListView}" 
                              Foreground="White" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListViewItem Content="Crear pedido" Padding="20 5"/>
                        <ListViewItem Content="Cerrar pedido" Padding="20 5"/>
                        <ListViewItem Content="Listar pedidos" Padding="20 5"/>
                    </ListView>
                </Expander>

            </StackPanel>
        </Border>

        <!-- ============================
             BOTÓN SALIR
             ============================ -->
        <Button Grid.Row="1"
                Grid.Column="0"
                Width="160"
                x:Name="salir"
                Click="salir_Click"
                Background="Transparent"
                BorderBrush="Transparent"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Cursor="Hand"
                Margin="5,10,0,10">

            <StackPanel Orientation="Horizontal">
                <Image Source="/Recursos/Iconos/salir.png"
                       Width="40"
                       Height="30"
                       HorizontalAlignment="Left"
                       Margin="-10,0,0,0"/>

                <TextBlock Text="Salir"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="5,0,0,0"
                           Foreground="White"
                           Height="15"
                           Width="50"/>
            </StackPanel>
        </Button>

        <!-- ============================
             DASHBOARD DERECHA
             ============================ -->
        <Grid Grid.Column="1" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Panel principal"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock FontSize="16" Margin="0,5,0,20" Foreground="White">
                          <Run Text="Bienvenido, "/>
                          <Run Text="{Binding UsuarioLogueado}"/>
                </TextBlock>

            </StackPanel>

            <!-- TARJETAS -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,10,0,0" HorizontalAlignment="Stretch">

                <!-- Artículos -->
                <Border Background="#3A3A3C" CornerRadius="8" Padding="15" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Artículos" Foreground="#FF9800" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="—" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Clientes -->
                <Border Background="#3A3A3C" CornerRadius="8" Padding="15" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Clientes" Foreground="#FF9800" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="—" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Órdenes -->
                <Border Background="#3A3A3C" CornerRadius="8" Padding="15" Margin="10">
                    <StackPanel>
                        <TextBlock Text="Órdenes abiertas" Foreground="#FF9800" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="—" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ACCESOS RÁPIDOS -->
            <StackPanel Grid.Row="2" Margin="0,30,0,0">
                <TextBlock Text="Accesos rápidos"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <WrapPanel ItemHeight="60" ItemWidth="180">

                    <!-- Crear artículo -->
                    <Button Content="Crear artículo"
                            Width="180"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnCrearArticulo_Click"/>

                    <!-- Crear cliente -->
                    <Button Content="Crear cliente"
                            Width="180"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnCrearCliente_Click"/>
                    <!-- Crear empleado -->
                    <Button Content="Crear empleado"
                            Width="180"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnCrearEmpleado_Click"/>

                    <!-- Crear escandallo -->
                    <Button Content="Crear escandallo"
                            Width="180"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnCrearEscandallo_Click"/>

                    <!-- Procesar orden (deshabilitado) -->
                    <Button Content="Procesar orden"
                            Width="180"
                            Height="60"
                            Margin="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#555"
                            Foreground="#AAA"
                            FontWeight="Bold"
                            IsEnabled="False"/>

                    <!-- Crear pedido (deshabilitado) -->
                    <Button Content="Crear pedido"
                            Width="180"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10"
                            Background="#555"
                            Foreground="#AAA"
                            FontWeight="Bold"
                            IsEnabled="False"/>

                </WrapPanel>
            </StackPanel>

        </Grid>

    </Grid>
</mah:MetroWindow>
