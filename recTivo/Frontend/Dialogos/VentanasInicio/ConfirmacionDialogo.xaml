<Window x:Class="recTivo.Frontend.Dialogos.VentanasInicio.ConfirmacionDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:recTivo.Frontend.Dialogos.VentanasInicio"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#2D2D30"
        WindowStartupLocation="CenterScreen"
        Title="Confirmar Salida" Height="200" Width="400">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="¿Seguro que quieres salir?"
                       Foreground="#FF9800"
                       FontSize="16"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Sí"
                        Width="80"
                        Background="#FF9800"
                        Foreground="White"
                        Click="BtnSi_Click"/>
                <Button Content="No"
                        Width="80"
                        Background="#E0E0E0"
                        Foreground="Black"
                        Click="BtnNo_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
