<Window x:Class="recTivo.Frontend.Dialogos.Escandallo.DialogoListarEscandallo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modelos="clr-namespace:recTivo.Backend.Modelos"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Height="600" Width="900">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="28"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="28"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding"    Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <!-- CABECERA -->
                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LISTAR ESCANDALLO"
                               Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0"/>
                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Grid.Column="1" Margin="0,0,20,0"/>
                </Grid>

                <!-- CONTENIDO -->
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selector de artículo -->
                    <Border Grid.Row="0" Background="#3A3A3D" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Código artículo:" Foreground="#FF9800" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="cmbCodigoArticulo"
                                      Width="160"
                                      ItemsSource="{Binding ArticulosTodos}"
                                      DisplayMemberPath="Codigo"
                                      SelectedValuePath="Codigo"
                                      SelectedValue="{Binding CodigoSeleccionado, Mode=TwoWay}"
                                      Margin="0,0,12,0"/>
                            <Button Content="Cargar"
                                    Width="120" Height="28"
                                    IsDefault="True"
                                    Click="BtnCargar_Click"
                                    Background="#FF9800" Foreground="White"
                                    BorderBrush="#FF9800" FontWeight="Bold" Cursor="Hand"
                                    Margin="0"/>
                        </WrapPanel>
                    </Border>

                    <!-- Descripción del artículo seleccionado -->
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,10"
                            BorderBrush="#FF9800" BorderThickness="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Descripcion}"  Foreground="White" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding Descripcion2}" Foreground="#AAA"/>
                        </WrapPanel>
                    </Border>

                    <!-- TREEVIEW -->
                    <Border Grid.Row="2" Background="#3A3A3D" CornerRadius="4"
                            Padding="4" BorderBrush="#555" BorderThickness="1">
                        <TreeView ItemsSource="{Binding EscandalloActual}"
                                  Background="#3A3A3D"
                                  Foreground="White"
                                  SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type modelos:ComponenteEscandallo}"
                                                          ItemsSource="{Binding Hijos}">
                                    <StackPanel Orientation="Horizontal" Margin="2,2">
                                        <TextBlock Text="{Binding CodigoArticulo}" FontWeight="Bold"
                                                   Foreground="#FF9800" Margin="0,0,6,0"/>
                                        <TextBlock Text=" — " Foreground="Black"/>
                                        <TextBlock Text="{Binding Descripcion}"  Foreground="Black" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Descripcion2}" Foreground="Black" Margin="0,0,12,0"/>
                                        <TextBlock Text="Cant: " Foreground="Black"/>
                                        <TextBlock Text="{Binding Cantidad}" FontWeight="Bold" Foreground="Black"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
