<Window x:Class="recTivo.Frontend.Dialogos.Escandallo.DialogoModificarEscandallo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MODIFICAR ESCANDALLO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,10">

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Selecciona código:" Foreground="#FF9800" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CodigosArticulos}"
                                      SelectedItem="{Binding CodigoSeleccionadoModificar, Mode=TwoWay}"
                                      Width="180" Height="30">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="Black"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Cargar escandallo"
                                x:Name="btnCargarEscandallo"
                                Click="btnCargarEscandallo_Click"
                                Width="150" Height="30"
                                VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Visibility="{Binding EscandalloVisible, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10">

                        <TextBlock Foreground="#FF9800" FontWeight="Bold" Margin="0,0,0,8">
                            <Run Text="Artículo: "/>
                            <Run Text="{Binding ArticuloFinal.Codigo, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding DescripcionFinal, Mode=OneWay}"/>
                        </TextBlock>

                        <Border Background="#3A3A3D" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Añadir componente:" Foreground="#FF9800" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ArticulosFiltrados}"
                                              SelectedItem="{Binding ArticuloComponenteSeleccionado, Mode=TwoWay}"
                                              Height="30">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Codigo}" Foreground="Black"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Cantidad:" Foreground="#FF9800" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ComponenteNuevo.Cantidad, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="TextBoxCantidad_LostFocus"
                                             Height="30"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="+ Añadir"
                                        x:Name="btnAñadirComponente"
                                        Click="btnAñadirComponente_Click"
                                        Width="90" Height="30"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Visibility="{Binding EscandalloVisible, Converter={StaticResource BoolToVis}}"
                            Background="#1E1E1E" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="4">

                        <TreeView ItemsSource="{Binding EscandalloActual}"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Hijos}">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CodigoArticulo}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Descripcion}"
                                                   Foreground="#AAAAAA"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="55" Height="24"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Margin="4,0"/>

                                        <Button Grid.Column="3"
                                                Content="✓ OK"
                                                Tag="{Binding}"
                                                Click="btnActualizarCantidad_Click"
                                                Width="55" Height="24"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Margin="2,0"/>

                                        <Button Grid.Column="4"
                                                Content="✕ Quitar"
                                                Tag="{Binding}"
                                                Click="btnQuitarComponente_Click"
                                                Width="62" Height="24"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Margin="2,0"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>

                        </TreeView>
                    </Border>

                    <Button Grid.Row="3"
                            x:Name="btnGuardarEscandallo"
                            Content="Guardar escandallo"
                            Click="btnGuardarEscandallo_Click"
                            Visibility="{Binding EscandalloVisible, Converter={StaticResource BoolToVis}}"
                            Width="200" Height="32"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
