<Window x:Class="recTivo.Frontend.Dialogos.Escandallo.DialogoAltaEscandallo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Height="500" Width="900">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA ESCANDALLO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <StackPanel Margin="20" Orientation="Vertical">

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Artículo final (Código):"
                                   Foreground="White"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding ListaArticulos}"
                                  SelectedItem="{Binding ArticuloFinal}"
                                  DisplayMemberPath="Codigo"
                                  HorizontalAlignment="Left"
                                  Width="200"/>

                        <TextBlock Text="{Binding DescripcionFinal}"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding Descripcion2Final}"
                                   Foreground="White"
                                   Margin="0,2,0,10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <StackPanel Width="200">
                            <TextBlock Text="Código componente:" Foreground="White"/>
                            <ComboBox ItemsSource="{Binding CodigosArticulos}"
                                      SelectedItem="{Binding ComponenteNuevo.Codigo}"/>
                        </StackPanel>

                        <StackPanel Width="120" Margin="20,0,0,0">
                            <TextBlock Text="Cantidad:" Foreground="White"/>
                            <TextBox Text="{Binding ComponenteNuevo.Cantidad}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Content="Añadir"
                                Click="BtnAñadir_Click"
                                VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Componentes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#E0E0E0"
                              Foreground="Black"
                              Height="200"
                              Margin="0,10,0,0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="*"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
                            <DataGridTextColumn Header="Descripción 2" Binding="{Binding Descripcion2}" Width="2*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Guardar Escandallo"
                            Click="BtnGuardar_Click"
                            HorizontalAlignment="Right"
                            Width="200"
                            Margin="0,20,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</Window>
