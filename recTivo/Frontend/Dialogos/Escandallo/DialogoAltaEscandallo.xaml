<Window x:Class="recTivo.Frontend.Dialogos.Escandallo.DialogoAltaEscandallo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:modelos="clr-namespace:recTivo.Backend.Modelos"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30"
        Height="750" Width="900">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF9800" BorderThickness="4">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ALTA ESCANDALLO"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0"/>

                    <TextBlock Text="Pulsa ESC para volver atrás"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Grid.Column="1"
                               Margin="0,0,10,0"/>
                </Grid>

                <StackPanel Margin="20" Orientation="Vertical">

                    <!-- ARTÍCULO SUPERIOR -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Artículo superior (Código):"
                                   Foreground="White"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding ArticulosPT}"
                                  SelectedItem="{Binding ArticuloFinal}"
                                  DisplayMemberPath="Codigo"
                                  HorizontalAlignment="Left"
                                  Width="200"/>

                        <Button Content="Cargar Escandallo"
                                Width="200"
                                Margin="0,-25,0,0"
                                VerticalAlignment="Top"
                                Click="BtnCargarEscandallo_Click"/>

                        <TextBlock Text="{Binding DescripcionFinal}"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding Descripcion2Final}"
                                   Foreground="White"
                                   Margin="0,2,0,10"/>
                    </StackPanel>

                    <!-- AÑADIR COMPONENTE -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <StackPanel Width="200">
                            <TextBlock Text="Código componente:" Foreground="White"/>
                            <ComboBox ItemsSource="{Binding ArticulosNoPT}"
                                      DisplayMemberPath="Codigo"
                                      SelectedItem="{Binding ArticuloComponenteSeleccionado, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Width="120" Margin="20,0,0,0">
                            <TextBlock Text="Cantidad:" Foreground="White"/>
                            <TextBox Text="{Binding ComponenteNuevo.Cantidad,
                                     Mode=TwoWay,
                                     UpdateSourceTrigger=LostFocus}"
                                     Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Content="Añadir raíz"
                                Click="BtnAñadir_Click"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"/>

                        <Button Content="Añadir como hijo"
                                Click="BtnAñadirHijo_Click"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <!-- MOSTRAR DESCRIPCIONES DEL COMPONENTE SELECCIONADO -->
                    <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                        <TextBlock Text="{Binding DescripcionComponente}"
                                   Foreground="White"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding Descripcion2Componente}"
                                   Foreground="White"
                                   Margin="0,2,0,10"/>
                    </StackPanel>

                    <!-- TREEVIEW DE JERARQUÍA -->
                    <TextBlock Text="Estructura del escandallo:"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TreeView ItemsSource="{Binding EscandalloActual}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Background="#E0E0E0"
                              Foreground="Black"
                              Height="350">

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type modelos:ComponenteEscandallo}"
                                  ItemsSource="{Binding Hijos}">
                                <StackPanel Orientation="Vertical" Margin="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CodigoArticulo}" 
                                                   FontWeight="Bold" 
                                                   Margin="5,0"/>
                                        <TextBlock Text=" | Cant: " />
                                        <TextBlock Text="{Binding Cantidad}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Descripcion}" 
                                               Margin="5,2,0,0"
                                               FontSize="11"
                                               Foreground="#555555"/>
                                    <TextBlock Text="{Binding Descripcion2}" 
                                               Margin="5,0,0,2"
                                               FontSize="11"
                                               Foreground="#555555"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- GUARDAR -->
                    <Button Content="Guardar Escandallo"
                            Click="BtnGuardar_Click"
                            HorizontalAlignment="Right"
                            Width="160"
                            Margin="0,25,20,0"/>

                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>