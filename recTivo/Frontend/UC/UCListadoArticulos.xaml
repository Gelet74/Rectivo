<UserControl x:Class="recTivo.Frontend.UC.UCListadoArticulos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d"
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="1100">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#3A3A3D"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderBrush"     Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

    </UserControl.Resources>

    <Border BorderBrush="#FF9800" BorderThickness="4">
        <DockPanel>

            <!-- CABECERA -->
            <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="LISTADO DE ARTÍCULOS"
                           Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0"/>

                <TextBlock Text="Pulsa ESC para volver atrás"
                           Foreground="White" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Grid.Column="1" Margin="0,0,20,0"/>
            </Grid>

            <!-- FILTROS -->
            <Border DockPanel.Dock="Top" Background="#3A3A3D"
                    Margin="20,12,20,8" Padding="12,8" CornerRadius="4">

                <WrapPanel Orientation="Horizontal">

                    <TextBlock Text="FILTROS:" Foreground="#FF9800" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Código" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding CodigosLista}"
                                  SelectedItem="{Binding FiltroCodigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Descripción" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding DescripcionesLista}"
                                  SelectedItem="{Binding FiltroDescripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Descripción 2" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Descripciones2Lista}"
                                  SelectedItem="{Binding FiltroDescripcion2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <Button Content="Limpiar filtros"
                            Click="btnLimpiarFiltros_Click"
                            Width="140" Height="30" Margin="0,18,0,0"/>

                    <Button Content="Exportar PDF"
                            Click="BtnExportarArticulos_Click"
                            Width="140" Height="30" Margin="10,18,0,0"/>

                </WrapPanel>
            </Border>

            <!-- DATAGRID -->
            <DataGrid Margin="20,0,20,20"
                      ItemsSource="{Binding ArticulosView}"
                      AutoGenerateColumns="False"
                      ColumnWidth="*"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      RowHeaderWidth="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Background="#3A3A3D"
                      RowBackground="#2D2D30"
                      Foreground="White"
                      AlternatingRowBackground="#333337"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#444444"
                      BorderThickness="0"
                      SelectedItem="{Binding ArticuloSeleccionado}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO"        Binding="{Binding Codigo}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN"   Binding="{Binding descrip}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN 2" Binding="{Binding descrip2}"/>
                    <DataGridTextColumn Header="STOCK"         Binding="{Binding Stock}"/>
                    <DataGridTextColumn Header="UBICACIONES"   Binding="{Binding UbicacionesResumen}"/>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Modificar artículo" x:Name="modificarArticulo"
                                  Click="modificarArticulo_Click"/>
                        <MenuItem Header="Eliminar artículo"
                                  Command="{Binding EliminarArticuloCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
