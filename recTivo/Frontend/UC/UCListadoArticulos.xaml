<UserControl x:Class="recTivo.Frontend.UC.UCListadoArticulos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d"
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
    <Grid DockPanel.Dock="Top">
            <TextBlock Text="LISTADO DE ARTÍCULOS"
                   FontSize="30"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="20,0,0,0"    
                   Foreground="#FF9800"/>
            <TextBlock Text="Pulsa ESC para volver atrás"
                       Foreground="#FF9800"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>
        <Grid>
            <DataGrid ItemsSource="{Binding ListaArticulos}"
                      AutoGenerateColumns="False"
                      ColumnWidth="*"
                      IsReadOnly="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      MaxHeight="350"
                      SelectedItem="{Binding codigoArticulo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO"
                                       Binding="{Binding Codigo}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Binding="{Binding Descrip}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN 2"
                                        Binding="{Binding Descrip2}"/>
                    <DataGridTextColumn Header="STOCK"
                                        Binding="{Binding Stock}"/>
                    <DataGridTextColumn Header="UBICACION"
                                        Binding="{Binding Ubicacion}"/>
                </DataGrid.Columns>
                
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
