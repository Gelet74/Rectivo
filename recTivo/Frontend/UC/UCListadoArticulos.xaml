<UserControl x:Class="recTivo.Frontend.UC.UCListadoArticulos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d"
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </UserControl.Resources>

    <DockPanel>

        <!-- CABECERA -->
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="LISTADO DE ARTÍCULOS"
                       FontSize="30"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="#FF9800"/>

            <TextBlock Text="Pulsa ESC para volver atrás"
                       Foreground="#FF9800"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>

        <!-- FILTROS -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="20,0"
                    HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="FILTROS: " Foreground="#FF9800"
                           Margin="0,0,20,0"/>
            </StackPanel>

            <!-- FILTRO CÓDIGO -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Código" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding CodigosLista}"
                          SelectedItem="{Binding FiltroCodigo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>
            </StackPanel>

            <!-- FILTRO DESCRIPCIÓN -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Descripción" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding DescripcionesLista}"
                          SelectedItem="{Binding FiltroDescripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>
            </StackPanel>

            <!-- FILTRO DESCRIPCIÓN 2 -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Descripción 2" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding Descripciones2Lista}"
                          SelectedItem="{Binding FiltroDescripcion2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>
            </StackPanel>

            <!-- BOTÓN LIMPIAR -->
            <Button Content="Limpiar filtros"
                    Width="150"
                    Height="30"
                    Margin="10,15,0,0"
                    BorderBrush="#FF5722"
                    Background="#E0E0E0"
                    Foreground="#FF5722"
                    FontWeight="Bold"
                    Click="btnLimpiarFiltros_Click"
/>
        </StackPanel>

        <!-- DATAGRID -->
        <Grid>
            <DataGrid ItemsSource="{Binding ArticulosView}"
                      AutoGenerateColumns="False"
                      ColumnWidth="*"
                      IsReadOnly="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      MaxHeight="860"
                      SelectedItem="{Binding ArticuloSeleccionado}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO"
                                        Binding="{Binding Codigo}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Binding="{Binding Descrip}"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN 2"
                                        Binding="{Binding Descrip2}"/>
                    <DataGridTextColumn Header="STOCK"
                                        Binding="{Binding Stock}"/>
                    <DataGridTextColumn Header="UBICACION"
                                        Binding="{Binding Ubicacion}"/>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Modificar artículo"
                                  x:Name="modificarArticulo"
                                  Click="modificarArticulo_Click"/>
                        <MenuItem Header="Eliminar artículo"
                                  Command="{Binding EliminarArticuloCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>
        </Grid>

    </DockPanel>
</UserControl>
