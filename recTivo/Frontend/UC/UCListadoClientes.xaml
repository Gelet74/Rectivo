<UserControl x:Class="recTivo.Frontend.UC.UCListadoClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d" 
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </UserControl.Resources>

    <DockPanel>
        <!-- CABECERA -->
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="LISTADO DE CLIENTES"
                       FontSize="30"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="#FF9800"/>

            <TextBlock Text="Pulsa ESC para volver atrás"
                       Foreground="#FF9800"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>

        <!-- FILTROS -->
        <StackPanel DockPanel.Dock="Top"
                 Orientation="Horizontal"
                 Margin="20,0"
                 HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="FILTROS: " Foreground="#FF9800"
                        Margin="0,0,20,0"/>
            </StackPanel>

            <!-- FILTRO NOMBRE -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Nombre" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding NombreLista}"
                          Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>
            </StackPanel>

            <!-- FILTRO APELLIDO -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Apellido 1" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding Apellido1Lista}"
                          Text="{Binding FiltroApellido1, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>    
            </StackPanel>

            <!-- FILTRO APELLIDO 2-->
            <StackPanel Margin="10,0">
                <TextBlock Text="Apellido 2" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding Apellido2Lista}"
               Text="{Binding FiltroApellido2, UpdateSourceTrigger=PropertyChanged}"
               IsEditable="True"
               Height="30"
               Margin="0,5"
               Width="150"/>
            </StackPanel>

            <!-- BOTÓN LIMPIAR -->
            <Button Content="Limpiar filtros"
                    Width="150"
                    Height="30"
                    Margin="10,15,0,0"
                    BorderBrush="#FF5722"
                    Background="#E0E0E0"
                    Foreground="#FF5722"
                    FontWeight="Bold"
                    Click="btnLimpiarFiltros_Click"/>


        </StackPanel>
        <Grid>
            <DataGrid ItemsSource="{Binding ClientesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Margin="20"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE" 
                                        Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="APELLIDO" 
                                        Binding="{Binding Apellido1}" Width="*"/>
                    <DataGridTextColumn Header="APELLIDO 2" 
                                        Binding="{Binding Apellido2}" Width="*"/>
                    <DataGridTextColumn Header="DNI" 
                                        Binding="{Binding Dni}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </DockPanel>
</UserControl>
