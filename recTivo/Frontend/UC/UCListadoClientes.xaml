<UserControl x:Class="recTivo.Frontend.UC.UCListadoClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d"
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#3A3A3D"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderBrush"     Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

    </UserControl.Resources>

    <Border BorderBrush="#FF9800" BorderThickness="4">
        <DockPanel>

            <!-- CABECERA -->
            <Grid DockPanel.Dock="Top" Height="40" Background="#808080">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="LISTADO DE CLIENTES"
                           Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0"/>

                <TextBlock Text="Pulsa ESC para volver atrás"
                           Foreground="White" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Grid.Column="1" Margin="0,0,20,0"/>
            </Grid>

            <!-- FILTROS -->
            <Border DockPanel.Dock="Top" Background="#3A3A3D"
                    Margin="20,12,20,8" Padding="12,8" CornerRadius="4">

                <WrapPanel Orientation="Horizontal">

                    <TextBlock Text="FILTROS:" Foreground="#FF9800" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Nombre" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding NombreLista}"
                                  Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Apellido 1" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Apellido1Lista}"
                                  Text="{Binding FiltroApellido1, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Apellido 2" Foreground="#FF9800" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Apellido2Lista}"
                                  Text="{Binding FiltroApellido2, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" Width="150"/>
                    </StackPanel>

                    <Button Content="Limpiar filtros"
                            Click="btnLimpiarFiltros_Click"
                            Width="140" Height="30" Margin="0,18,0,0"/>

                    <Button Content="Exportar PDF"
                            Click="BtnExportarClientes_Click"
                            Width="140" Height="30" Margin="10,18,0,0"/>

                </WrapPanel>
            </Border>

            <!-- DATAGRID -->
            <DataGrid Margin="20,0,20,20"
                      ItemsSource="{Binding ClientesView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      Background="#3A3A3D"
                      RowBackground="#2D2D30"
                      Foreground="White"
                      AlternatingRowBackground="#333337"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#444444"
                      BorderThickness="0">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE"     Binding="{Binding Nombre}"    Width="*"/>
                    <DataGridTextColumn Header="APELLIDO"   Binding="{Binding Apellido1}" Width="*"/>
                    <DataGridTextColumn Header="APELLIDO 2" Binding="{Binding Apellido2}" Width="*"/>
                    <DataGridTextColumn Header="DNI"        Binding="{Binding Dni}"       Width="*"/>
                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
