<UserControl x:Class="recTivo.Frontend.UC.UCListadoClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d" 
             Background="#2D2D30"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </UserControl.Resources>

    <DockPanel>
        <!-- CABECERA -->
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="LISTADO DE CLIENTES"
                       FontSize="30"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       Foreground="#FF9800"/>

            <TextBlock Text="Pulsa ESC para volver atrás"
                       Foreground="#FF9800"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
        </Grid>

        <!-- FILTROS -->
        <StackPanel DockPanel.Dock="Top"
                 Orientation="Horizontal"
                 Margin="20,0"
                 HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="FILTROS: " Foreground="#FF9800"
                        Margin="0,0,20,0"/>
            </StackPanel>

            <!-- FILTRO NOMBRE -->
            <StackPanel Margin="10,0">
                <TextBlock Text="Nombre" Foreground="#FF9800"/>
                <ComboBox ItemsSource="{Binding NombresLista}"
                          Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          Height="30"
                          Margin="0,5"
                          Width="150"/>
            </StackPanel>



        </StackPanel>
        <Grid>

        </Grid>
    </DockPanel>
</UserControl>
