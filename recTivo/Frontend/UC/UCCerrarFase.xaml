<UserControl x:Class="recTivo.Frontend.UC.UCCerrarFase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#2D2D30"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#E0E0E0"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="5"/>
            <Setter Property="Height"          Value="30"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Height"     Value="30"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F44336"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,2,0,4"/>
        </Style>
        <!-- ── Sobreescribir MaterialDesign en DataGrid ── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#3A3A3D"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderBrush"     Value="#555"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- CABECERA -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="CERRAR ÓRDENES"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="20,10,0,0" Foreground="#FF9800"/>
            <TextBlock Text="Pulsa ESC para volver atrás"
                       Foreground="#FF9800" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,10,20,0"/>
        </Grid>

        <!-- CUERPO -->
        <Grid Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLUMNA IZQUIERDA: listado de órdenes ─────────────── -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">

                <Border DockPanel.Dock="Top" Background="#3A3A3D"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Órdenes pendientes"
                                   Foreground="#FF9800" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button Content="↻" Click="BtnRecargar_Click"
                                Width="28" Height="28" Margin="8,0,0,0"
                                Background="Transparent" Foreground="#FF9800"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                ToolTip="Recargar"/>
                    </StackPanel>
                </Border>

                <DataGrid DockPanel.Dock="Top"
                          ItemsSource="{Binding OrdenesFiltradas}"
                          SelectedItem="{Binding OrdenSeleccionada, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" RowHeaderWidth="0"
                          Background="#3A3A3D" RowBackground="#3A3A3D"
                          AlternatingRowBackground="#2D2D30"
                          Foreground="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#555555"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Codigo}"
                                            Width="110" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="Descripción 2"
                                            Binding="{Binding Descrip2}" Width="*"/>
                        <DataGridTextColumn Header="Fecha fin"
                                            Binding="{Binding FechaFin}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ── COLUMNA DERECHA: detalle orden + fases ────────────── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding FasesVisible, Converter={StaticResource BoolToVis}}">

                    <!-- Cabecera del PS -->
                    <Border Background="#1E1E1E" CornerRadius="4"
                            Padding="14,10" Margin="0,0,0,12"
                            BorderBrush="#FF9800" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Orden #" Foreground="#AAA" FontSize="12"/>
                                    <TextBlock Text="{Binding OrdenSeleccionada.IdOrden, Mode=OneWay}"
                                               Foreground="#AAA" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding OrdenSeleccionada.Codigo, Mode=OneWay}"
                                               Foreground="#FF9800" FontSize="18" FontWeight="Bold"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding OrdenSeleccionada.Descripcion, Mode=OneWay}"
                                           Foreground="White" FontSize="13" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding OrdenSeleccionada.Descrip2, Mode=OneWay}"
                                           Foreground="#AAA" FontSize="12" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Foreground="#AAA" FontSize="11" Text="Cantidad / Fecha fin"/>
                                <TextBlock Foreground="White" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Text="{Binding OrdenSeleccionada.Cantidad, Mode=OneWay,
                                                  StringFormat='{}{0} uds'}"/>
                                <TextBlock Foreground="White" FontSize="13" HorizontalAlignment="Right"
                                           Text="{Binding OrdenSeleccionada.FechaFin, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FASES -->
                    <ItemsControl ItemsSource="{Binding FasesOrden}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="#2A2A2D"/>
                                            <Setter Property="BorderBrush"     Value="#444"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                    <Setter Property="Background"      Value="#3A3A3D"/>
                                                    <Setter Property="BorderBrush"     Value="#555"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding NombreFaseTexto}"
                                                       FontWeight="Bold" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                                <Setter Property="Foreground" Value="#FF9800"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="16" Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"       Value="⏳"/>
                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                                                    <Setter Property="Text"       Value="✔"/>
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                                                           Text="{Binding EstadoTexto}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="Cerrada">
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Foreground="#AAA" Text="Entrada: "/>
                                            <TextBlock Foreground="White" FontWeight="Bold"
                                                       Text="{Binding CantidadEntrada}" Margin="0,0,16,0"/>
                                            <TextBlock Foreground="#AAA" Text="Fecha límite: "/>
                                            <TextBlock Foreground="White"
                                                       Text="{Binding FechaFin, StringFormat=dd/MM/yyyy}"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <TextBlock Foreground="#AAA" Text="OK: "/>
                                            <TextBlock Foreground="#4CAF50" FontWeight="Bold"
                                                       Text="{Binding CantidadOK}" Margin="0,0,16,0"/>
                                            <TextBlock Foreground="#AAA" Text="Defectos: "/>
                                            <TextBlock Foreground="#F44336" FontWeight="Bold"
                                                       Text="{Binding CantidadDefecto}" Margin="0,0,16,0"/>
                                            <TextBlock Foreground="#AAA" Text="Fecha cierre: "/>
                                            <TextBlock Foreground="White"
                                                       Text="{Binding FechaFin, StringFormat=dd/MM/yyyy}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- PANEL DE CIERRE -->
                    <Border Visibility="{Binding HayFaseActiva, Converter={StaticResource BoolToVis}}"
                            Background="#3A3A3D" BorderBrush="#FF9800" BorderThickness="2"
                            CornerRadius="4" Padding="14,12" Margin="0,4,0,8">
                        <StackPanel>

                            <!-- Título -->
                            <Border Background="#FF9800" CornerRadius="3"
                                    Padding="10,6" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Foreground="#1E1E1E" FontWeight="Bold" FontSize="15"
                                               Text="{Binding NombreFaseActiva}"/>
                                    <TextBlock Foreground="#1E1E1E" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="Orden #"/>
                                        <Run Text="{Binding OrdenSeleccionada.IdOrden, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding OrdenSeleccionada.Codigo, Mode=OneWay}"/>
                                        <Run Text=" · Entrada: "/>
                                        <Run Text="{Binding FaseActiva.CantidadEntrada, Mode=OneWay}"/>
                                        <Run Text=" uds"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Campos de cierre -->
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Cantidad OK:" Foreground="#FF9800" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CierreCantidadOK, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Cantidad defectos:" Foreground="#FF9800" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CierreCantidadDefecto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Fecha de cierre:" Foreground="#FF9800" Margin="0,0,0,3"/>
                                    <DatePicker SelectedDate="{Binding CierreFecha, Mode=TwoWay}"
                                                Width="140"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- ── UBICACIÓN: solo visible en la última fase ── -->
                            <Border Visibility="{Binding EsUltimaFase, Converter={StaticResource BoolToVis}}"
                                    Background="#2A2A2D" BorderBrush="#FF9800" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="📦  Ubicación en almacén"
                                               Foreground="#FF9800" FontWeight="Bold"
                                               FontSize="12" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Pasillo:" Foreground="#AAA"
                                                       FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Width="80" MaxLength="5" CharacterCasing="Upper"
                                                     ToolTip="Letra del pasillo (ej: A, B, P)"
                                                     Text="{Binding UbicacionPasillo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Estantería:" Foreground="#AAA"
                                                       FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding UbicacionEstanteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="80"
                                                     ToolTip="Número de estantería"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Hueco:" Foreground="#AAA"
                                                       FontSize="11" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding UbicacionHueco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="80"
                                                     ToolTip="Número de hueco"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ErrorCierreFase}"
                                       Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>

                            <Button Content="{Binding TextoBotonCerrar}"
                                    Click="BtnCerrarFase_Click"
                                    IsEnabled="{Binding PuedeCerrarFase}"
                                    Width="160" Height="32"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Background="#E0E0E0" Foreground="#FF9800"
                                    BorderBrush="#FF9800" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Mensaje todas cerradas -->
                    <Border Background="#1B3A1B" CornerRadius="4" Padding="14,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayFaseActiva}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Todas las fases de esta orden están cerradas."
                                   Foreground="#4CAF50" FontWeight="Bold"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</UserControl>
