<UserControl x:Class="recTivo.Frontend.UC.UCDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:recTivo.Frontend.UC"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#2D2D30">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA CON BOTÓN CAMBIAR USUARIO -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                <TextBlock Text="Panel principal"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock FontSize="16" Margin="0,5,0,10" Foreground="#D0D0D0">
                    <Run Text="Bienvenido, "/>
                    <Run Text="{Binding UsuarioLogueado}"/>
                </TextBlock>
            </StackPanel>

            <!-- BOTÓN CAMBIAR USUARIO -->
            <Button Content="Cambiar usuario"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="150"
                    Height="35"
                    Background="#FF9800"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnCambiarUsuario_Click"
                    Cursor="Hand">
                <Button.ToolTip>
                    <ToolTip Content="Cerrar sesión y volver al login"/>
                </Button.ToolTip>
            </Button>
        </Grid>

        <!-- ACCESOS RÁPIDOS (arriba) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Accesos rápidos"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#D0D0D0"
                       Margin="0,0,0,8"/>

            <WrapPanel ItemHeight="50" ItemWidth="170">
                <!-- Crear artículo -->
                <Button Content="Crear artículo"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        x:Name="btnCrearArticulo" Click="BtnCrearArticulo_Click"/>

                <!-- Crear cliente -->
                <Button Content="Crear cliente"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        x:Name="btnCrearCliente" Click="BtnCrearCliente_Click"/>

                <!-- Crear empleado -->
                <Button Content="Crear empleado"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        x:Name="btnCrearEmpleado" Click="BtnCrearEmpleado_Click"/>

                <!-- Crear escandallo -->
                <Button Content="Crear escandallo"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        x:Name="btnCrearEscandallo" Click="BtnCrearEscandallo_Click"/>

                <!-- Procesar orden -->
                <Button x:Name="btnProcesarOrden" Content="Procesar orden"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        Click="BtnProcesarOrden_Click"/>

                <!-- Crear pedido -->
                <Button x:Name="btnCrearPedido" Content="Crear pedido"
                        Width="170"
                        Height="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,10,8"
                        Background="#FF9800"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        Click="btnCrearPedido_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- SEPARADOR -->
        <Separator Grid.Row="2" Background="#555555" Margin="0,0,0,16"/>

        <!-- TARJETAS DE TOTALES (debajo de accesos rápidos) -->
        <UniformGrid Grid.Row="3" Columns="4" HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <!-- Artículos -->
            <Border Background="#3A3A3C"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Recursos/Iconos/Articulos.png"
                           Width="45"
                           Height="45"
                           VerticalAlignment="Center"
                           Margin="5,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total Artículos"
                                   Foreground="#FF9800"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalArticulos}"
                                   Foreground="White"
                                   Margin="40,0,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Clientes -->
            <Border Background="#3A3A3C"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Recursos/Iconos/Clientes.png"
                           Width="45"
                           Height="45"
                           VerticalAlignment="Center"
                           Margin="5,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total Clientes"
                                   Foreground="#FF9800"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalClientes}"
                                   Foreground="White"
                                   Margin="70,0,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Órdenes -->
            <Border Background="#3A3A3C"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Recursos/Iconos/Ordenes.png"
                           Width="45"
                           Height="45"
                           VerticalAlignment="Center"
                           Margin="5,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Órdenes Abiertas"
                                   Foreground="#FF9800"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalOrdenes}"
                                   Foreground="White"
                                   Margin="90,0,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empleados -->
            <Border Background="#3A3A3C"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Recursos/Iconos/Empleado.png"
                           Width="45"
                           Height="45"
                           VerticalAlignment="Center"
                           Margin="5,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total Empleados"
                                   Foreground="#FF9800"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalEmpleados}"
                                   Foreground="White"
                                   Margin="70,0,0,0"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>